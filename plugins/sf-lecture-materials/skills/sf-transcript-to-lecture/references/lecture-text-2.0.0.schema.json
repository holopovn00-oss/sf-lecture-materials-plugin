{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sf.education/sf-lecture-publisher/schemas/lecture-text/2.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "folder_id",
    "source_blocks_hash",
    "blocks",
    "transformation_ledger",
    "assertions",
    "content_hash",
    "title",
    "structure",
    "source_locators"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "folder_id": {
      "type": "string",
      "minLength": 1
    },
    "source_blocks_hash": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "transformation_ledger": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assertions": {
      "type": "object",
      "required": [
        "complete_source_accounting",
        "direct_perspective_tags",
        "semantic_review_required"
      ],
      "properties": {
        "complete_source_accounting": {
          "const": true
        },
        "direct_perspective_tags": {
          "const": true
        },
        "semantic_review_required": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "structure": {
      "type": "object",
      "required": [
        "sections",
        "topics",
        "placements"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "section_id",
              "number",
              "title"
            ],
            "properties": {
              "section_id": {
                "type": "string",
                "minLength": 1
              },
              "number": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "topic_id",
              "section_id",
              "title"
            ],
            "properties": {
              "topic_id": {
                "type": "string",
                "minLength": 1
              },
              "section_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "placements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "source_locators": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object"
        }
      }
    }
  },
  "additionalProperties": false
}
